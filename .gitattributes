# Kept out of `git archive` (the release zip, bin/build-zip.sh). The zip keeps
# the plugin's PHP, the built assets with their unminified builds and their
# sources in assets/src/ (wordpress.org Guideline 4), readme.txt, languages/
# and LICENSE; build-zip.sh refuses anything else.
/.github export-ignore
/bin export-ignore
/tests export-ignore
/assets/src/**/*.test.ts export-ignore
/.wp-env.json export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/composer.json export-ignore
/composer.lock export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/phpcs.xml.dist export-ignore
/phpunit.xml.dist export-ignore
/phpstan.neon.dist export-ignore
/CLAUDE.md export-ignore
/README.md export-ignore
/webpack.config.cjs export-ignore
/tsconfig.json export-ignore
/.wordpress-org export-ignore
