{
	"compilerOptions": {
		"target": "ES2019",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["assets/src/loader/**/*.ts", "assets/src/gate/**/*.ts", "assets/src/admin/**/*.ts"]
}
